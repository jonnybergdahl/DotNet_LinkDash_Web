@{
    // Each view sets ViewData["Title"] (the page's <h1>) and ViewData["Page"] (the menu entry it belongs to).
    var page = ViewData["Page"] as string;
    string? Current(string name) => name == page ? "page" : null;
    var message = TempData[Bergdahl.LinkDash.Web.Controllers.SettingsController.MessageKey] as string;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    <script src="~/js/app.js" asp-append-version="true" defer></script>
    <script src="~/js/search.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="app">

        @* Top bar: app icon + name left, search centre, action icons right *@
        <header class="topbar">
            <div class="topbar-start">
                <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
                    <span class="icon">menu</span>
                </button>
                <a class="app-title" asp-controller="Home" asp-action="Index">
                    <img class="app-icon" src="~/img/app-icon.svg" alt="" width="32" height="32" />
                    <span class="app-name">@AppInfo.Name</span>
                </a>
            </div>

            @* Searches pages, groups and links through HomeController.Search. Ctrl/⌘ K focuses it. *@
            <div class="search" data-search data-search-url="@Url.Action("Search", "Home")">
                <div class="search-field">
                    <span class="icon">search</span>
                    <input type="search" placeholder="Search" aria-label="Search" autocomplete="off"
                           role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" data-search-input />
                    <kbd class="search-shortcut" data-search-shortcut>Ctrl K</kbd>
                    <button class="icon-button search-close" type="button" aria-label="Close search" data-search-close>
                        <span class="icon">close</span>
                    </button>
                </div>
                <ul class="search-results" id="search-results" role="listbox" aria-label="Search results" hidden data-search-results></ul>
            </div>

            <div class="topbar-actions">
                <button class="icon-button search-open" type="button" aria-label="Search" title="Search" data-search-open>
                    <span class="icon">search</span>
                </button>
                <button class="icon-button" type="button" data-theme-toggle aria-label="Theme: system" title="Theme: system">
                    <span class="icon">brightness_auto</span>
                </button>

                @* Account menu: always last *@
                <div class="dropdown" data-dropdown>
                    <button class="icon-button" type="button" data-dropdown-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="account-menu" aria-label="Account" title="Account">
                        <span class="icon">account_circle</span>
                    </button>
                    <div class="dropdown-menu" id="account-menu" role="menu" hidden>
                        @if (signedIn)
                        {
                            <div class="dropdown-header">@User.Identity!.Name</div>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Index" role="menuitem"><span class="icon">person</span>Account</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item" type="submit" role="menuitem"><span class="icon">logout</span>Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login" role="menuitem"><span class="icon">login</span>Sign in</a>
                        }
                    </div>
                </div>
            </div>
        </header>

        @* Left menu *@
        <nav class="sidebar" id="sidebar" aria-label="Main">
            <ul class="nav">
                <li><a class="nav-link" asp-controller="Home" asp-action="Index" aria-current="@Current(AppInfo.Pages.Dashboard)"><span class="icon">dashboard</span>Dashboard</a></li>
                <li class="nav-section">Settings</li>
                <li><a class="nav-link" asp-controller="Settings" asp-action="Index" aria-current="@Current(AppInfo.Pages.Groups)"><span class="icon">folder</span>Groups</a></li>
                <li><a class="nav-link" asp-controller="Settings" asp-action="Links" aria-current="@Current(AppInfo.Pages.Links)"><span class="icon">link</span>Links</a></li>
            </ul>
        </nav>
        <div class="scrim"></div>

        <main class="main">
            @RenderBody()
        </main>

        <footer class="footer">
            <p>@AppInfo.Name, Copyright&copy; @DateTime.Now.Year, Jonny Bergdahl, <a href="@AppInfo.RepositoryUrl">GitHub</a></p>
        </footer>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="snackbar" role="status">@message</div>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
