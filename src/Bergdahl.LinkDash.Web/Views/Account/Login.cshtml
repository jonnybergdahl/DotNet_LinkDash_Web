@model LoginFormModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign in";
}

<form class="login-card" asp-action="Login" method="post">
    <h1 class="login-title">
        <img class="app-icon" src="~/img/app-icon.svg" alt="" width="40" height="40" />
        <span>@AppInfo.Name</span>
    </h1>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="field-error"></div>

    <label class="field">
        <span>@Html.DisplayNameFor(m => m.Username)</span>
        <input asp-for="Username" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
        <span asp-validation-for="Username" class="field-error"></span>
    </label>

    <label class="field">
        <span>@Html.DisplayNameFor(m => m.Password)</span>
        <input asp-for="Password" autocomplete="current-password" required />
        <span asp-validation-for="Password" class="field-error"></span>
    </label>

    <label class="check">
        <input asp-for="RememberMe" />
        <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
    </label>

    <button class="button" type="submit"><span class="icon">login</span>Sign in</button>
</form>
