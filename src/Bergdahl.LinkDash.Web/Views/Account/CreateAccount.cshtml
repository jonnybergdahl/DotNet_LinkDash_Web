@model CreateAccountFormModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Create account";
}

<form class="login-card" asp-action="CreateAccount" method="post">
    <h1 class="login-title">
        <img class="app-icon" src="~/img/app-icon.svg" alt="" width="40" height="40" />
        <span>@AppInfo.Name</span>
    </h1>
    <p class="muted">Welcome! Create the administrator account that is used to change groups and links.</p>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="field-error"></div>

    <label class="field">
        <span>@Html.DisplayNameFor(m => m.Username)</span>
        <input asp-for="Username" autocomplete="username" autocapitalize="none" spellcheck="false" required />
        <span asp-validation-for="Username" class="field-error"></span>
    </label>

    <label class="field">
        <span>@Html.DisplayNameFor(m => m.Password)</span>
        <input asp-for="Password" autocomplete="new-password" minlength="@Bergdahl.LinkDash.Web.Authentication.AdminCredentials.MinPasswordLength" required autofocus />
        <small class="field-hint">At least @Bergdahl.LinkDash.Web.Authentication.AdminCredentials.MinPasswordLength characters.</small>
        <span asp-validation-for="Password" class="field-error"></span>
    </label>

    <label class="field">
        <span>@Html.DisplayNameFor(m => m.ConfirmPassword)</span>
        <input asp-for="ConfirmPassword" autocomplete="new-password" required />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </label>

    <button class="button" type="submit"><span class="icon">person_add</span>Create account</button>
</form>
