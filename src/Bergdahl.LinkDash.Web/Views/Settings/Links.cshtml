@model LinksViewModel
@{
    ViewData["Title"] = "Links";
    ViewData["Page"] = AppInfo.Pages.Links;
    var selected = Model.SelectedGroup;
}

<section class="page">
    <header class="page-header page-header-actions">
        <div>
            <h1>Links</h1>
            <p>The links in each group, in the order they are shown.</p>
        </div>
        @if (selected is not null)
        {
            <a class="button" asp-action="AddLink" asp-route-groupId="@selected.Id"><span class="icon">add</span>Add link</a>
        }
    </header>

    @if (selected is null)
    {
        <div class="card">
            <p class="muted">There are no groups yet. Add a <a asp-action="AddGroup">group</a> first.</p>
        </div>
    }
    else
    {
        <form class="group-picker" asp-action="Links" method="get">
            <label class="field">
                <span>Group</span>
                <span class="select group-picker-select">
                    <span class="group-picker-icon mdi @LinkValidation.IconCssClass(selected.Icon, "mdi:folder")" aria-hidden="true"></span>
                    <select name="groupId" data-auto-submit>
                        @foreach (var group in Model.Groups)
                        {
                            <option value="@group.Id" selected="@(group.Id == selected.Id)">@group.Name (@group.Links.Count)</option>
                        }
                    </select>
                </span>
            </label>
            <noscript>
                <button type="submit" class="button secondary">Show</button>
            </noscript>
        </form>

        <div class="card">
            @if (selected.Links.Count == 0)
            {
                <p class="muted">No links in this group.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th class="col-icon"><span class="visually-hidden">Icon</span></th>
                                <th>Title</th>
                                <th class="col-actions"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var l = 0; l < selected.Links.Count; l++)
                            {
                                var link = selected.Links[l];
                                <tr id="link-@link.Id">
                                    <td class="col-icon">
                                        <partial name="_LinkIcon" model='new LinkIconModel(link, "table-icon")' />
                                    </td>
                                    <td class="cell-title">
                                        @link.Title
                                        <a class="cell-url" href="@link.Url" target="_blank" rel="noopener noreferrer" title="@link.Url">@link.Url</a>
                                    </td>
                                    <td class="col-actions">
                                        <div class="actions">
                                            <form asp-action="MoveLink" asp-route-groupId="@selected.Id" asp-route-linkId="@link.Id" asp-route-direction="@MoveDirection.Up" method="post">
                                                <button type="submit" class="icon-button" title="Move link up" aria-label="Move link up" disabled="@(l == 0)">
                                                    <span class="icon">arrow_upward</span>
                                                </button>
                                            </form>
                                            <form asp-action="MoveLink" asp-route-groupId="@selected.Id" asp-route-linkId="@link.Id" asp-route-direction="@MoveDirection.Down" method="post">
                                                <button type="submit" class="icon-button" title="Move link down" aria-label="Move link down" disabled="@(l == selected.Links.Count - 1)">
                                                    <span class="icon">arrow_downward</span>
                                                </button>
                                            </form>
                                            <a class="icon-button" asp-action="EditLink" asp-route-groupId="@selected.Id" asp-route-linkId="@link.Id" title="Edit link" aria-label="Edit link">
                                                <span class="icon">edit</span>
                                            </a>
                                            <form asp-action="DeleteLink" asp-route-groupId="@selected.Id" asp-route-linkId="@link.Id" method="post"
                                                  data-confirm="Delete the link &quot;@link.Title&quot;?">
                                                <button type="submit" class="icon-button danger" title="Delete link" aria-label="Delete link">
                                                    <span class="icon">delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</section>
