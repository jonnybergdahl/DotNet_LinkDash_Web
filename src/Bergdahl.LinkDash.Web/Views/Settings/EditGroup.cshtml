@model GroupFormModel
@{
    ViewData["Title"] = Model.IsNew ? "Add group" : "Edit group";
    ViewData["Page"] = AppInfo.Pages.Groups;
    var iconField = new IconFieldModel(nameof(Model.Icon), Model.Icon, LinkValidation.BlankIcon, "Leave empty for no icon.");
}

<section class="page">
    <header class="page-header">
        <p class="breadcrumb">Groups</p>
        <h1>@ViewData["Title"]</h1>
    </header>

    <form asp-action="@(Model.IsNew ? "AddGroup" : "EditGroup")" method="post">
        @if (!Model.IsNew)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div class="card">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="form-grid">
                <label class="field">
                    <span>@Html.DisplayNameFor(m => m.Name)</span>
                    <input asp-for="Name" placeholder="e.g. Work" autocomplete="off" required autofocus />
                    <span asp-validation-for="Name" class="field-error"></span>
                </label>
                <partial name="_IconField" model="iconField" />
            </div>
        </div>
        <div class="form-actions">
            <button class="button" type="submit"><span class="icon">@(Model.IsNew ? "add" : "save")</span>@(Model.IsNew ? "Add" : "Save")</button>
            <a class="button secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
